{%- liquid
  assign logo_count = 0
  for block in section.blocks
    if block.settings.logo != blank
      assign logo_count = logo_count | plus: 1
    endif
  endfor
-%}

{%- if logo_count > 0 or request.design_mode -%}
  <div
    class="crunchy-logos crunchy-logos--{{ section.settings.alignment }}"
    style="--cl-bg: {{ section.settings.background }}; --cl-text: {{ section.settings.text_color }}; --cl-logo-h: {{ section.settings.logo_height }}px; --cl-cols: {{ section.settings.columns_mobile }}; --cl-cols-desktop: {{ section.settings.columns_desktop }}; --cl-pt: {{ section.settings.padding_top }}px; --cl-pb: {{ section.settings.padding_bottom }}px;"
  >
    <div class="crunchy-logos__inner">
      {%- if section.settings.heading != blank -%}
        <h2 class="crunchy-logos__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.text != blank -%}
        <div class="crunchy-logos__text">{{ section.settings.text }}</div>
      {%- endif -%}

      <ul class="crunchy-logos__grid" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.logo != blank or request.design_mode -%}
            <li
              class="crunchy-logos__item{% if block.settings.wide %} crunchy-logos__item--wide{% endif %}"
              {{ block.shopify_attributes }}
            >
              {%- capture logo -%}
                {%- if block.settings.logo != blank -%}
                  {%- liquid
                    assign alt = block.settings.title | default: block.settings.logo.alt
                    if block.settings.wide
                      assign sizes = '(min-width: 750px) 440px, 68vw'
                    else
                      assign sizes = '(min-width: 750px) 220px, 34vw'
                    endif
                    echo block.settings.logo | image_url: width: 800 | image_tag: loading: 'lazy', widths: '160, 240, 320, 480, 640, 800', sizes: sizes, alt: alt, class: 'crunchy-logos__img'
                  -%}
                {%- else -%}
                  <span class="crunchy-logos__placeholder">
                    {{- block.settings.title | default: 'Charity logo' | escape -}}
                  </span>
                {%- endif -%}
              {%- endcapture -%}

              {%- if block.settings.url != blank -%}
                <a class="crunchy-logos__link" href="{{ block.settings.url }}" target="_blank" rel="noopener">
                  {{- logo -}}
                  <span class="crunchy-logos__sr">(opens in a new tab)</span>
                </a>
              {%- else -%}
                {{ logo }}
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .crunchy-logos {
    display: block;
    padding: var(--cl-pt) 0 var(--cl-pb);
    background: var(--cl-bg);
    color: var(--cl-text);
  }

  .crunchy-logos *,
  .crunchy-logos *::before,
  .crunchy-logos *::after {
    box-sizing: border-box;
  }

  .crunchy-logos__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
  }

  .crunchy-logos__heading {
    margin: 0 0 20px;
    color: inherit;
    font-size: 26px;
    line-height: 1.2;
  }

  .crunchy-logos__text {
    max-width: 60ch;
    margin: -8px 0 24px;
    font-size: 15px;
    line-height: 1.5;
  }

  .crunchy-logos__text p {
    margin: 0;
  }

  .crunchy-logos--center .crunchy-logos__heading,
  .crunchy-logos--center .crunchy-logos__text {
    margin-inline: auto;
    text-align: center;
  }

  .crunchy-logos__grid {
    --cl-gap: 16px;
    display: flex;
    flex-wrap: wrap;
    gap: 20px var(--cl-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .crunchy-logos--center .crunchy-logos__grid {
    justify-content: center;
  }

  .crunchy-logos__item {
    --cl-cell: calc((100% - (var(--cl-cols) - 1) * var(--cl-gap)) / var(--cl-cols));
    display: flex;
    flex: 0 0 var(--cl-cell);
    align-items: center;
    justify-content: center;
    height: calc(var(--cl-logo-h) * 0.8);
    margin: 0;
  }

  .crunchy-logos__item--wide {
    flex-basis: calc(var(--cl-cell) * 2 + var(--cl-gap));
  }

  .crunchy-logos__link {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 8px;
    transition: opacity 0.2s ease;
  }

  .crunchy-logos__link:hover {
    opacity: 0.85;
  }

  .crunchy-logos__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }

  .crunchy-logos__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .crunchy-logos__placeholder {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 8px;
    border: 1px dashed currentColor;
    border-radius: 8px;
    font-size: 12px;
    line-height: 1.3;
    text-align: center;
  }

  .crunchy-logos__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (min-width: 750px) {
    .crunchy-logos__inner {
      padding: 0 32px;
    }

    .crunchy-logos__heading {
      margin-bottom: 28px;
      font-size: 32px;
    }

    .crunchy-logos__grid {
      --cl-gap: 24px;
      row-gap: 28px;
    }

    .crunchy-logos__item {
      --cl-cols: var(--cl-cols-desktop);
      height: var(--cl-logo-h);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .crunchy-logos__link {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
